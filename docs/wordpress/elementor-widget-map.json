  "css_exceptions": [
    {
      "template": "login",
      "widget": "login",
      "location": "widget Custom CSS",
      "reason": "password eye placement absent from native Login controls",
      "css": "selector .elementor-field-type-text{position:relative}selector .elinstyle-password-toggle{position:absolute;left:0;bottom:0;width:54px;height:54px;border:0;background:none;color:inherit}selector input[name=password]{padding-inline-end:54px}"
    },
    {
      "template": "guide",
      "widget": "tabs",
      "location": "widget Custom CSS",
      "reason": "classic Tabs table cells have no native per-cell style control",
      "css": "selector table{width:100%;border-collapse:collapse}selector th,selector td{padding:12px;text-align:right;border-bottom:1px solid #DADCD2}"
    },
    {
      "template": "kit",
      "location": "Site Settings > Custom CSS",
      "reason": "site-wide skip link is outside individual Elementor widgets",
      "css": ".skip{position:absolute;inset-inline-start:16px;top:-100px;background:#fff;color:#242622;padding:8px 16px;z-index:10000}.skip:focus{top:0}"
    }
  ],
  "custom_widget": {
    "name": "elinstyle-catalog",
    "reason": "faceted Woo multi-select filters, URL/history, slider/chips and server fallback are not provided by native Products",
    "style_location": "widget-scoped existing catalog stylesheet + native widget controls",
    "controls": [
      "columns/responsive gap",
      "product color and typography",
      "filter typography and accent",
      "sidebar width and layout gap"
    ]
  }
}